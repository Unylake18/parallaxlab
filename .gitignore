# Ambiente Python
.venv/
__pycache__/
*.py[cod]

# PyCharm
.idea/

# Manim
media/

# Renders
renders/*
!renders/.gitkeep

# Blender (sandbox do arsenal): saídas geradas pelos scripts, regeneráveis (renders, sequências PNG, .blend e backups)
experimentos/blender/out/
experimentos/blender/**/*.blend
experimentos/blender/**/*.blend1

# Áudio dos vídeos longos: os WAV passam de 100 MB (limite de arquivo do GitHub); guardar no Drive
videos_longos/*/audio/*.wav
videos_longos/*/audio/partes/

# Caches
.pytest_cache/
.ruff_cache/

# Sistema operacional
.DS_Store
Thumbs.db

# Entregas finais organizadas por videos/entregar.py (cópias dos MP4/áudio; ficam fora do Git)
entregas/*
!entregas/.gitkeep

# Mídia pesada fica só no PC (vídeo, áudio, zips de frames/capas, renders do Manim); o repositório guarda código e parâmetros
*.mp4
*.mov
*.webm
*.wav
*.zip
videos/*/media*/
videos_longos/*/media*/

# Frames 3D intermediários (Blender) e dependências Node ficam só no PC
videos/*/frames3d_*/
node_modules/
